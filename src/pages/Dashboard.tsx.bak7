 className="bg-theme-card p-4 rounded-xl border border-theme-border h-32 flex flex-col gap-3"> <div className="flex gap-3"> <div className="w-8 h-8 bg-slate-200 rounded shrink-0"></div> <div className="flex-1"> <div className="h-4 bg-slate-200 rounded w-3/4 mb-2"></div> <div className="h-3 bg-slate-200 rounded w-1/2"></div> </div> </div> <div className="mt-auto flex justify-between"> <div className="h-3 bg-slate-200 rounded w-12"></div> <div className="h-4 bg-slate-200 rounded w-4"></div> </div> </div> )) 
