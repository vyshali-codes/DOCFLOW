 className="bg-theme-card border border-theme-border dark:border-theme-border text-theme-text hover:text-red-600 hover:border-red-200 hover:bg-red-50 dark:hover:bg-red-900/20 px-4 py-2 rounded-md text-sm font-medium transition-colors shadow-sm flex items-center gap-2 mr-2" > Empty Trash </button> <ConfirmModal isOpen={
      {showTemplateModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
