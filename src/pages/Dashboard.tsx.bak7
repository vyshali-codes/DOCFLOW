import React, {
 useMemo, useRef, useState 
}
 from 'react';
 import {
 LayoutGrid, List, Upload, Plus, Filter, ChevronRight, Home, Loader2, FileText, Search, X, Trash2, Users, Star, Clock, HardDrive 
}
 from 'lucide-react';
