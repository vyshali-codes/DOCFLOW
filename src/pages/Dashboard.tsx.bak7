 </div> ) ) : filteredFiles.length === 0 ? ( <div className="flex flex-col items-center justify-center flex-1 text-center p-8 bg-theme-card rounded-2xl shadow-sm border border-theme-border dark:border-theme-border"> <div className="w-24 h-24 mb-6 flex items-center justify-center rounded-full bg-theme-bg /50"> {
