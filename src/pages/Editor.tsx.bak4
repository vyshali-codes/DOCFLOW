import {
 toast 
}
 from "react-toastify";
 import React, {
 useState, useEffect, useRef 
}
 from "react";
 import {
 useParams, useNavigate 
}
 from "react-router-dom";
 import {
 ArrowLeft, History, Save, Users as UsersIcon, Check, MessageSquare, Send, X, 
}
 from "lucide-react";
 import {
 useAppContext 
}
 from "../lib/AppContext";
 import {
 diffWords 
}
 from "diff";
 import {
 motion, AnimatePresence 
}
 from "framer-motion";
 import {
 TipTapEditor 
}
 from "../components/TipTapEditor";
 import {
 fileService 
}
 from "../lib/fileService";
 import {
 doc, onSnapshot, getDoc, collection, setDoc, addDoc, updateDoc, deleteDoc, query, orderBy, getDocs, 
}
 from "firebase/firestore";
 import {
 db, auth 
}
 from "../lib/firebase";
 /* Basic version interface */ interface Version {
 id: string;
 content: string;
 timestamp: string;
 author: string;
 
}
 interface Comment {
 id: string;
 text: string;
 author: string;
 timestamp: number;
 startIndex: number;
 endIndex: number;
 quotedText: string;
 resolved: boolean;
 
}
 export default function Editor() {
 const {
 id 
}
 = useParams<{
 id: string 
}
 >();
 const navigate = useNavigate();
 const {
 user 
}
 = useAppContext();
 const [content, setContent] = useState('');
 const [initialLoad, setInitialLoad] = useState(true);
 const [isSaving, setIsSaving] = useState(false);
 const [fileName, setFileName] = useState('Document Editor');
 /* Version history state */ const [showHistory, setShowHistory] = useState(false);
 const [versions, setVersions] = useState<Version[]>([]);
 const [compareMode, setCompareMode] = useState(false);
 const [selectedVersion1, setSelectedVersion1] = useState<string | null>(null);
 const [selectedVersion2, setSelectedVersion2] = useState<string | null>(null);
 /* Comment state */ const [comments, setComments] = useState<Comment[]>([]);
 const [showComments, setShowComments] = useState(false);
 const [selectedTextRange, setSelectedTextRange] = useState<{
 start: number, end: number, text: string 
}
 | null>(null);
 const [newCommentText, setNewCommentText] = useState('');
 const [showCommentInput, setShowCommentInput] = useState(false);
  const [showExportMenu, setShowExportMenu] = useState(false);
  const [saveStatus, setSaveStatus] = useState<'idle' | 'saving' | 'saved'>('idle');

  const handleExport = async (format: 'pdf' | 'markdown' | 'docx') => {
    if (format === 'markdown') {
      const turndownService = new TurndownService();
      const markdown = turndownService.turndown(content);
      const blob = new Blob([markdown], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${fileName}.md`;
      a.click();
      URL.revokeObjectURL(url);
    } else if (format === 'pdf') {
      const element = document.querySelector('.ProseMirror') as HTMLElement;
      if (element) {
        toast.info("Generating PDF...");
        const canvas = await html2canvas(element, { scale: 2 });
        const imgData = canvas.toDataURL('image/png');
        const pdf = new jsPDF('p', 'mm', 'a4');
        const pdfWidth = pdf.internal.pageSize.getWidth();
        const pdfHeight = (canvas.height * pdfWidth) / canvas.width;
        pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
        pdf.save(`${fileName}.pdf`);
        toast.success("PDF Downloaded");
      }
    } else if (format === 'docx') {
      const header = "<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Export HTML To Doc</title></head><body>";
      const footer = "</body></html>";
      const sourceHTML = header + content + footer;
      const source = 'data:application/vnd.ms-word;charset=utf-8,' + encodeURIComponent(sourceHTML);
      const fileDownload = document.createElement("a");
      document.body.appendChild(fileDownload);
      fileDownload.href = source;
      fileDownload.download = `${fileName}.docx`;
      fileDownload.click();
      document.body.removeChild(fileDownload);
    }
    setShowExportMenu(false);
  };
  
  useEffect(() => {
    const handleGlobalSave = () => {
      saveVersion();
    };
    window.addEventListener('global-save', handleGlobalSave);
    return () => window.removeEventListener('global-save', handleGlobalSave);
  }, [saveVersion]);
 const textareaRef = useRef<HTMLTextAreaElement>(null);
 /* Debounce timeout ref */ const saveTimeoutRef = useRef<NodeJS.Timeout | null>(null);
 useEffect(() => {
 if (!id || !user) return;
 /* Load initial versions */ const loadVersions = async () => {
 try {
 const versionsRef = collection(db, 'documents', id, 'versions');
 const q = query(versionsRef, orderBy('createdAt', 'desc'));
 const snapshot = await getDocs(q);
 const loadedVersions = snapshot.docs.map(doc => {
 const data = doc.data();
 return {
 id: doc.id, content: data.content, timestamp: new Date(data.createdAt.toMillis()).toISOString(), author: data.createdBy === user.id ? 'You' : 'Unknown' 
}
 ;
 
}
 );
 setVersions(loadedVersions);
 
}
 catch (err) {
 console.error("Could not load versions", err);
 
}
 
}
 ;
 loadVersions();
 /* Subscribe to document changes */ const docRef = doc(db, 'documents', id);
 const unsubscribe = onSnapshot(docRef, (snapshot) => {
 if (snapshot.exists()) {
 const data = snapshot.data();
 setFileName(data.title || 'Untitled');
 if (data.isDeleted) {
 toast.info("This document is in the trash. It cannot be edited.");
 navigate('/dashboard');
 return;
 
}
 /* Only update content... */ /* OT... */ if (initialLoad) {
 setContent(data.content || '');
 setInitialLoad(false);
 
}
 
}
 
}
 );
 /* Subscribe to comments */ const unsubscribeComments = onSnapshot(query(collection(db, 'documents', id, 'comments'), orderBy('timestamp', 'desc')), (snapshot) => {
 const loadedComments = snapshot.docs.map(doc => ({
 id: doc.id, ...doc.data() } as Comment));
 setComments(loadedComments);
 
}
 );
 return () => {
 unsubscribe();
 unsubscribeComments();
 if (saveTimeoutRef.current) clearTimeout(saveTimeoutRef.current);
 
}
 ;
 
}
 , [id, user, initialLoad]);
 const handleChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
 const newContent = e.target.value;
 setContent(newContent);
 /* Auto-save debounce */ if (saveTimeoutRef.current) clearTimeout(saveTimeoutRef.current);
 saveTimeoutRef.current = setTimeout(() => {
 if (id) {
 fileService.updateDocument(id, {
 content: newContent } as any);
 
}
 
}
 , 1000);
 
}
 ;
 const handleSelect = (e: React.SyntheticEvent<HTMLTextAreaElement>) => {
 const target = e.target as HTMLTextAreaElement;
 if (target.selectionStart !== target.selectionEnd) {
 setSelectedTextRange({
 start: target.selectionStart, end: target.selectionEnd, text: target.value.substring(target.selectionStart, target.selectionEnd) 
}
 );
 
}
 else {
 setSelectedTextRange(null);
 setShowCommentInput(false);
 
}
 
}
 ;
 const handleAddComment = async () => {
 if (!id || !user || !selectedTextRange || !newCommentText.trim()) return;
 try {
 await addDoc(collection(db, 'documents', id, 'comments'), {
 text: newCommentText.trim(), author: user.name, timestamp: Date.now(), startIndex: selectedTextRange.start, endIndex: selectedTextRange.end, quotedText: selectedTextRange.text, resolved: false 
}
 );
 setNewCommentText('');
 setShowCommentInput(false);
 setSelectedTextRange(null);
 setShowComments(true);
 
}
 catch (err) {
 console.error("Failed to add comment", err);
 
}
 
}
 ;
 const handleResolveComment = async (commentId: string) => {
 if (!id) return;
 try {
 await updateDoc(doc(db, 'documents', id, 'comments', commentId), {
 resolved: true 
}
 );
 
}
 catch (err) {
 console.error("Failed to resolve comment", err);
 
}
 
}
 ;
 const saveVersion = async () => {
 if (!id || !user) return;
 setIsSaving(true);
 try {
 /* First save current content */ await fileService.updateDocument(id, {
 content: content } as any);
 /* Then create version */ const versionRef = doc(collection(db, 'documents', id, 'versions'));
 await setDoc(versionRef, {
 content: content, createdBy: user.id, createdAt: new Date() 
}
 );
 const newVersion: Version = {
 id: versionRef.id, content, timestamp: new Date().toISOString(), author: 'You' 
}
 ;
 setVersions([newVersion, ...versions]);
 
}
 catch (err) {
 console.error("Failed to save version", err);
 
}
 finally {
 setIsSaving(false);
 
}
 
}
 ;
 const restoreVersion = async (versionId: string) => {
 const v = versions.find(v => v.id === versionId);
 if (v && id) {
 setContent(v.content);
 await fileService.updateDocument(id, {
 content: v.content } as any);
 setShowHistory(false);
 setCompareMode(false);
 
}
 
}
 ;
 const renderDiff = (oldText: string, newText: string) => {
 const differences = diffWords(oldText, newText);
 return differences.map((part, index) => {
 const color = part.added ? 'bg-green-100 text-green-800' : part.removed ? 'bg-red-100 text-red-800 line-through' : '';
 return <span key={
 index 
}
 className={
 color 
}
 >{
 part.value 
}
 </span>;
 
}
 );
 
}
 ;
 return ( <div className="flex flex-col h-screen bg-theme-bg"> {
 /* Editor Header */ 
}
 <header className="h-14 bg-theme-card border-b border-theme-border flex items-center justify-between px-4 shrink-0"> <div className="flex items-center gap-4"> <button onClick={
 () => navigate('/dashboard') 
}
        <div className="h-6 w-px bg-slate-200 dark:bg-theme-border"></div>
        <h1 className="font-semibold text-theme-text truncate max-w-sm">{fileName}</h1>
        {saveStatus === "saving" && (
          <div className="flex items-center gap-1.5 text-xs text-theme-muted ml-2">
            <Loader2 className="w-3 h-3 animate-spin" /> Saving...
          </div>
        )}
        {saveStatus === "saved" && (
          <div className="flex items-center gap-1.5 text-xs text-green-600 dark:text-green-500 ml-2">
            <Check className="w-3 h-3" /> All changes saved
          </div>
        )}
      </div>
      <div className="flex items-center gap-2">
        <div className="relative">
          <button onClick={() => setShowExportMenu(!showExportMenu)} className="flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium text-theme-muted hover:bg-theme-card-hover transition-colors">
            <Download className="w-4 h-4" /> Export
          </button>
          {showExportMenu && (
            <div className="absolute top-full right-0 mt-1 w-48 bg-theme-card border border-theme-border rounded-lg shadow-lg py-1 z-50">
              <button onClick={() => handleExport("pdf")} className="w-full text-left px-4 py-2 text-sm text-theme-text hover:bg-theme-card-hover flex items-center gap-2"><FileDown className="w-4 h-4" /> Export as PDF</button>
              <button onClick={() => handleExport("docx")} className="w-full text-left px-4 py-2 text-sm text-theme-text hover:bg-theme-card-hover flex items-center gap-2"><FileDown className="w-4 h-4" /> Export as DOCX</button>
              <button onClick={() => handleExport("markdown")} className="w-full text-left px-4 py-2 text-sm text-theme-text hover:bg-theme-card-hover flex items-center gap-2"><FileDown className="w-4 h-4" /> Export as Markdown</button>
            </div>
          )}
        </div>
 () => {
 setShowComments(!showComments);
 setShowHistory(false);
 
}
 
}
 className={
 `flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
 showComments ? 'bg-theme-card-hover text-theme-text' : 'text-theme-muted hover:bg-theme-card-hover' 
}
 ` 
}
 > <MessageSquare className="w-4 h-4" /> Comments </button> <button onClick={
 () => {
 setShowHistory(!showHistory);
 setShowComments(false);
 
}
 
}
 className={
 `flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
 showHistory ? 'bg-theme-card-hover text-theme-text' : 'text-theme-muted hover:bg-theme-card-hover' 
}
 ` 
}
 > <History className="w-4 h-4" /> Activity </button> <button onClick={
 saveVersion 
}
 className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-md text-sm font-medium transition-colors shadow-sm" > {
 isSaving ? <Check className="w-4 h-4" /> : <Save className="w-4 h-4" /> 
}
 {
 isSaving ? 'Saved' : 'Save Version' 
}
 </button> </div> </header> <div className="flex-1 flex overflow-hidden"> {
 /* Editor Area */ 
}
 <div className="flex-1 overflow-auto p-8 flex justify-center relative"> {
 selectedTextRange && ( <div className="absolute top-4 bg-theme-bg text-white rounded-lg shadow-xl p-2 flex items-center gap-2 z-20"> <span className="text-xs font-medium px-2 truncate max-w-[200px]">"{
 selectedTextRange.text 
}
 "</span> <button onClick={
 () => {
 setShowComments(true);
 setShowHistory(false);
 setShowCommentInput(true);
 
}
 
}
 className="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors" > Add Comment </button> </div> ) 
}
 <div className="w-full max-w-4xl bg-theme-card shadow-sm border border-theme-border rounded-xl min-h-[800px] flex flex-col relative overflow-hidden"> {
 !initialLoad && user && ( <TipTapEditor documentId={
 id! 
}
 initialContent={
 content 
}
 currentUser={
 user 
}
 /> ) 
}
 </div> </div> {
 /* Version History Sidebar */ 
}
 <AnimatePresence> {
 showHistory && ( <motion.div initial={
 {
 width: 0, opacity: 0 
}
 
}
 animate={
 {
 width: 320, opacity: 1 
}
 
}
 exit={
 {
 width: 0, opacity: 0 
}
 
}
 className="border-l border-theme-border bg-theme-card flex flex-col shrink-0 overflow-hidden" > <div className="p-4 border-b border-theme-border flex justify-between items-center bg-theme-bg"> <h3 className="font-semibold text-theme-text">Activity & Versions</h3> </div> <div className="p-4 border-b border-theme-border"> <label className="flex items-center gap-2 text-sm text-theme-text cursor-pointer"> <input type="checkbox" checked={
 compareMode 
}
 onChange={
 e => {
 setCompareMode(e.target.checked);
 setSelectedVersion1(null);
 setSelectedVersion2(null);
 
}
 
}
 className="rounded border-theme-border text-blue-600 focus:ring-blue-500" /> Compare two versions </label> </div> <div className="flex-1 overflow-y-auto"> {
 versions.map((v) => ( <div key={
 v.id 
}
 className="p-4 border-b border-theme-border hover:bg-theme-bg transition-colors"> <div className="flex items-start justify-between mb-2"> <div> <div className="text-sm font-medium text-theme-text">{
 new Date(v.timestamp).toLocaleString() 
}
 </div> <div className="text-xs text-theme-muted mt-1">{
 v.author 
}
 </div> </div> {
 compareMode ? ( <div className="flex flex-col gap-1"> <label className="text-[10px] flex items-center gap-1 cursor-pointer"> <input type="radio" name="v1" checked={
 selectedVersion1 === v.id 
}
 onChange={
 () => setSelectedVersion1(v.id) 
}
 /> V1 </label> <label className="text-[10px] flex items-center gap-1 cursor-pointer"> <input type="radio" name="v2" checked={
 selectedVersion2 === v.id 
}
 onChange={
 () => setSelectedVersion2(v.id) 
}
 /> V2 </label> </div> ) : ( <button onClick={
 () => restoreVersion(v.id) 
}
 className="text-xs font-medium text-blue-600 hover:text-blue-800 bg-blue-50 px-2 py-1 rounded" > Restore </button> ) 
}
 </div> <div className="text-xs text-theme-muted line-clamp-2 bg-theme-card-hover p-2 rounded border border-theme-border"> {
 v.content 
}
 </div> </div> )) 
}
 </div> </motion.div> ) 
}
 {
 showComments && ( <motion.div initial={
 {
 width: 0, opacity: 0 
}
 
}
 animate={
 {
 width: 320, opacity: 1 
}
 
}
 exit={
 {
 width: 0, opacity: 0 
}
 
}
 className="border-l border-theme-border bg-theme-card flex flex-col shrink-0 overflow-hidden" > <div className="p-4 border-b border-theme-border flex justify-between items-center bg-theme-bg shrink-0"> <h3 className="font-semibold text-theme-text">Comments</h3> </div> <div className="flex-1 overflow-y-auto p-4 flex flex-col gap-4"> {
 showCommentInput && selectedTextRange && ( <div className="bg-theme-bg p-3 rounded-lg border border-theme-border shadow-sm animate-in fade-in slide-in-from-top-4"> <div className="text-xs text-theme-muted mb-2 border-l-2 border-theme-border pl-2 italic line-clamp-2"> "{
 selectedTextRange.text 
}
 " </div> <textarea autoFocus value={
 newCommentText 
}
 onChange={
 e => setNewCommentText(e.target.value) 
}
 placeholder="Add a comment..." className="w-full h-20 text-sm p-2 border border-theme-border rounded-md outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none mb-2" /> <div className="flex justify-end gap-2"> <button onClick={
 () => {
 setShowCommentInput(false);
 setNewCommentText('');
 
}
 
}
 className="px-3 py-1.5 text-xs text-theme-muted hover:bg-theme-card-hover rounded-md transition-colors">Cancel</button> <button onClick={
 handleAddComment 
}
 className="px-3 py-1.5 text-xs bg-blue-600 text-white hover:bg-blue-700 rounded-md transition-colors font-medium flex items-center gap-1"> <Send className="w-3 h-3" /> Post </button> </div> </div> ) 
}
 {
 comments.length === 0 && !showCommentInput ? ( <div className="text-center text-theme-muted text-sm mt-8 flex flex-col items-center"> <MessageSquare className="w-8 h-8 mb-2 opacity-50" /> <p>No comments yet.</p> <p className="text-xs mt-1">Select text to add a comment.</p> </div> ) : ( comments.map(comment => ( <div key={
 comment.id 
}
 className={
 `p-3 rounded-lg border text-sm transition-all ${
 comment.resolved ? 'bg-theme-bg border-theme-border opacity-60' : 'bg-theme-card border-theme-border shadow-sm' 
}
 ` 
}
 > <div className="flex items-center justify-between mb-2"> <div className="font-medium text-theme-text">{
 comment.author 
}
 </div> <div className="text-xs text-theme-muted">{
 new Date(comment.timestamp).toLocaleDateString() 
}
 </div> </div> <div className="text-xs text-theme-muted mb-2 border-l-2 border-blue-200 pl-2 italic bg-blue-50/50 py-1 line-clamp-3"> "{
 comment.quotedText 
}
 " </div> <div className="text-theme-text mb-3">{
 comment.text 
}
 </div> {
 !comment.resolved && ( <div className="flex justify-end"> <button onClick={
 () => handleResolveComment(comment.id) 
}
 className="text-xs text-blue-600 hover:text-blue-800 font-medium px-2 py-1 hover:bg-blue-50 rounded transition-colors" > Resolve </button> </div> ) 
}
 </div> )) ) 
}
 </div> </motion.div> ) 
}
 </AnimatePresence> </div> {
 /* Comparison Modal Overlay */ 
}
 <AnimatePresence> {
 compareMode && selectedVersion1 && selectedVersion2 && ( <motion.div initial={
 {
 opacity: 0 
}
 
}
 animate={
 {
 opacity: 1 
}
 
}
 exit={
 {
 opacity: 0 
}
 
}
 className="fixed inset-0 z-50 bg-theme-bg/50 flex items-center justify-center p-8" > <div className="bg-theme-card rounded-xl shadow-2xl w-full max-w-5xl h-[80vh] flex flex-col overflow-hidden"> <div className="px-6 py-4 border-b border-theme-border flex justify-between items-center bg-theme-bg"> <h2 className="font-semibold text-lg text-theme-text">Version Comparison</h2> <div className="flex gap-3"> <button onClick={
 () => {
 setCompareMode(false);
 setSelectedVersion1(null);
 setSelectedVersion2(null);
 
}
 
}
 className="px-4 py-2 text-sm text-theme-muted hover:bg-theme-card-hover rounded-md font-medium"> Close </button> <button onClick={
 () => restoreVersion(selectedVersion2) 
}
 className="px-4 py-2 text-sm bg-blue-600 text-white hover:bg-blue-700 rounded-md font-medium shadow-sm"> Restore V2 </button> </div> </div> <div className="flex-1 overflow-auto p-8 bg-theme-bg"> <div className="bg-theme-card p-8 border border-theme-border rounded-lg shadow-sm font-mono text-sm whitespace-pre-wrap leading-relaxed"> {
 renderDiff( versions.find(v => v.id === selectedVersion1)?.content || '', versions.find(v => v.id === selectedVersion2)?.content || '' ) 
}
 </div> </div> </div> </motion.div> ) 
}
 </AnimatePresence> </div> );
 
}
 