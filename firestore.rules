rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isOwner() {
      return existing().ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow write: if isSignedIn() && userId == request.auth.uid;
    }
    
    match /activities/{activityId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }
    
    match /folders/{folderId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(folderId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(folderId) && isOwner() && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(folderId) && isOwner();
    }

    match /documents/{documentId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(documentId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(documentId) && isOwner() && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(documentId) && isOwner();
      
      match /versions/{versionId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(versionId) && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid && incoming().createdBy == request.auth.uid;
        
        match /chunks/{chunkId} {
           allow read, list: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
           allow create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        }
      }
      
      match /chunks/{chunkId} {
        allow read, list: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        allow update, delete: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && (
          (incoming().ownerId == request.auth.uid) || (exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid)
        );
      }

      match /comments/{commentId} {
        allow read, list: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
        allow create, update, delete: if isSignedIn() && exists(/databases/$(database)/documents/documents/$(documentId)) && get(/databases/$(database)/documents/documents/$(documentId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
