{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "A document managed by DocFlow.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 255 },
        "content": { "type": "string", "maxLength": 1048576 },
        "type": { "type": "string", "enum": ["pdf", "docx", "image", "text", "markdown"] },
        "ownerId": { "type": "string", "maxLength": 128 },
        "tags": { 
          "type": "array", 
          "items": { "type": "string", "maxLength": 50 },
          "maxItems": 20
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "ownerId", "type", "createdAt", "updatedAt"]
    },
    "DocumentVersion": {
      "title": "Document Version",
      "description": "A specific version of a document.",
      "type": "object",
      "properties": {
        "content": { "type": "string", "maxLength": 1048576 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" }
      },
      "required": ["content", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Stores documents."
    },
    "/documents/{documentId}/versions/{versionId}": {
      "schema": "DocumentVersion",
      "description": "Stores versions of a document."
    }
  }
}
